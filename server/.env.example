# Copy this to server/.env — never commit the real file.

# ── Provider ───────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:31b-cloud

# ── Ollama (default provider) ──────────────────────────────────────────────────
# The Ollama app must be running locally. Sign in first: ollama signin
OLLAMA_URL=http://localhost:11434

# ── Groq (fallback provider) ───────────────────────────────────────────────────
# Switch: LLM_PROVIDER=groq  LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=your_groq_api_key_here

# ── Shared ─────────────────────────────────────────────────────────────────────
PORT=3000
# Raise if cloud model is slow; default is 8000ms.
# LLM_TIMEOUT_MS=8000
